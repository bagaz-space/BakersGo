# Neon Serverless Postgres (via Vercel Marketplace)
# Pooled connection — used for all regular queries
DATABASE_URL="postgresql://user:password@ep-xxx.sin1.neon.tech/neondb?sslmode=require"

# Direct (non-pooled) connection — required by Prisma migrate
DIRECT_URL="postgresql://user:password@ep-xxx.sin1.neon.tech/neondb?sslmode=require"

JWT_SECRET="your-super-secret-key-change-this-min-32-chars"
PORT=3000
NODE_ENV=development
