{
  "expo": {
    "name": "BakersGo",
    "slug": "bakersgo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F0E8"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F5F0E8"
      },
      "package": "com.bakersgo.app"
    },
    "scheme": "bakersgo",
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ]
  }
}
